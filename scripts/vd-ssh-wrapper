#!/bin/bash
set -eo pipefail
export VD_HOME="${VD_HOME:-/opt/vibe-deploy}"
cmd="${SSH_ORIGINAL_COMMAND:-}"

if [[ -z "$cmd" ]]; then
  echo '{"ok":false,"command":"ssh","error":{"code":"NO_COMMAND","message":"Interactive shell not allowed"}}'
  exit 1
fi
logger -t vd-ssh "user=${LOGNAME:-unknown} cmd=${cmd}" 2>/dev/null || true
# vd reads SSH_ORIGINAL_COMMAND itself: it splits it with sh quoting (no
# expansion) and refuses vd exec / db-backup-all. Splitting it here, unquoted,
# cut "0 2 * * *" into words and expanded the * as globs.
exec /usr/local/bin/vd
