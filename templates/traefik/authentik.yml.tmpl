# Auto-generated by vd init. Do not edit manually.
#
# Authentik, reached over the {{.Network}} overlay rather than its public URL.
# The outpost resolves an app's provider from X-Forwarded-Host; going out through
# host nginx and the swarm Traefik would overwrite that header, and preserving
# Host instead loops back into vd-traefik via the *.apps server block.
# See docs/plans/forward-auth.md §2.

http:
  services:
    authentik:
      loadBalancer:
        # The outpost's own paths (/outpost.goauthentik.io/*) are routed here per
        # app, at a higher priority than the app's own router.
        servers:
          - url: "{{.Internal}}"

  middlewares:
    # Shared by every app deployed with --auth: the address is the same for all of
    # them, and only the per-app strip-identity and ingress-secret middlewares
    # differ. Referenced from container labels as `authentik-fa@file`.
    authentik-fa:
      forwardAuth:
        address: "{{.Internal}}/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-uid
          - X-authentik-username
          - X-authentik-email
          - X-authentik-name
          - X-authentik-groups
