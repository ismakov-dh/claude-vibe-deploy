# Auto-generated by vibe-deploy. Do not edit manually.
# App: {{.Name}} | Type: {{.AppType}} | Generated: {{.Timestamp}}

services:
  {{.Name}}:
    build:
      context: ./src
      dockerfile: Dockerfile.vd
    container_name: vd-{{.Name}}
    restart: unless-stopped
{{- if .HasEnvFile}}
    env_file:
      - ./src/.env
{{- end}}
    labels:
      - "vd.app={{.Name}}"
      - "vd.port={{.Port}}"
      - "traefik.enable=true"
{{- if eq .Routing "subdomain"}}
      - "traefik.http.routers.vd-{{.Name}}.rule=Host(`{{.Name}}.{{.Domain}}`)"
{{- else}}
      - "traefik.http.routers.vd-{{.Name}}.rule=PathPrefix(`/{{.Name}}`)"
      - "traefik.http.middlewares.vd-{{.Name}}-strip.stripprefix.prefixes=/{{.Name}}"
      - "traefik.http.routers.vd-{{.Name}}.middlewares=vd-{{.Name}}-strip"
{{- end}}
      - "traefik.http.services.vd-{{.Name}}.loadbalancer.server.port={{.Port}}"
      - "traefik.http.routers.vd-{{.Name}}.entrypoints=web"
{{- if .Auth}}
      # --- forward auth (docs/plans/forward-auth.md §2) -----------------------
      # Chain, outermost first: strip whatever identity the client sent, ask the
      # Authentik outpost, then stamp the ingress secret last so nothing after
      # it can remove it. The app trusts X-authentik-* only alongside that secret:
      # every vd app shares vd-net and can reach this container directly.
      - "traefik.http.routers.vd-{{.Name}}.middlewares=vd-{{.Name}}-strip-identity,authentik-fa@file,vd-{{.Name}}-ingress"
      # Must list every header in authResponseHeaders (traefik-dynamic/authentik.yml)
      # name for name: forwardAuth only overwrites the ones the outpost actually
      # returns, so an unlisted one arrives exactly as the client sent it.
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-authentik-uid="
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-authentik-username="
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-authentik-email="
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-authentik-name="
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-authentik-groups="
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-Vibe-Ingress="
      # Pin what the outpost uses to pick a provider. nginx and the entrypoint
      # trust chain pass a client's X-Forwarded-Host through, forwardAuth with
      # trustForwardHeader relays it, and the outpost resolves the application
      # from it: a member of app A could send X-Forwarded-Host: A to B's host
      # with A's cookie, pass as A, and receive B's ingress secret. The router
      # already matched this host, so it is the only correct value. Uri, Method
      # and Port are blanked, not forced: forwardAuth then fills them from the
      # real request (traefik v3.3 pkg/middlewares/auth/forward.go writeHeader).
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-Forwarded-Host={{.Name}}.{{.Domain}}"
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-Forwarded-Uri="
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-Forwarded-Method="
      - "traefik.http.middlewares.vd-{{.Name}}-strip-identity.headers.customrequestheaders.X-Forwarded-Port="
      - "traefik.http.middlewares.vd-{{.Name}}-ingress.headers.customrequestheaders.X-Vibe-Ingress={{.IngressSecret}}"
      # The outpost's own paths (start, callback, sign_out) must reach the outpost
      # on the app's host, not the app. No explicit priority, same reasoning as
      # the MCP /.well-known/ router below: this rule is a strict superset of the
      # app's, so it always wins, where a literal number stops winning once the
      # app name makes the app rule long enough.
      - "traefik.http.routers.vd-{{.Name}}-outpost.rule=Host(`{{.Name}}.{{.Domain}}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      - "traefik.http.routers.vd-{{.Name}}-outpost.entrypoints=web"
      - "traefik.http.routers.vd-{{.Name}}-outpost.service=authentik@file"
      # The outpost resolves start/callback/sign_out by X-Forwarded-Host too, so
      # the same pinning applies here. No forwardAuth: this router is the login.
      - "traefik.http.routers.vd-{{.Name}}-outpost.middlewares=vd-{{.Name}}-strip-identity"
{{- end}}
    networks:
      - vd-net
{{- if .NeedsDB}}
      - vd-db
{{- end}}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:{{.Port}}/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

{{- if .NeedsMCP}}

  # Read-only database MCP for this app, at {{.Name}}.mcp.{{.Domain}}.
  # Connects as a SELECT-only companion role; see internal/db/provision.go.
  {{.Name}}-mcp:
    image: {{.MCPImage}}
    container_name: vd-{{.Name}}-mcp
    restart: unless-stopped
    command: ["--transport=sse", "--sse-port=8089", "--sse-host=0.0.0.0", "--access-mode=restricted"]
    env_file:
      - ./mcp.env
    labels:
      - "vd.app={{.Name}}"
      - "vd.role=mcp"
      - "traefik.enable=true"
      - "traefik.http.services.vd-{{.Name}}-mcp.loadbalancer.server.port=8089"
      - "traefik.http.routers.vd-{{.Name}}-mcp.rule=Host(`{{.Name}}.mcp.{{.Domain}}`)"
      - "traefik.http.routers.vd-{{.Name}}-mcp.entrypoints=web"
      - "traefik.http.routers.vd-{{.Name}}-mcp.service=vd-{{.Name}}-mcp"
      - "traefik.http.routers.vd-{{.Name}}-mcp.middlewares=vd-{{.Name}}-mcp-auth"
      - "traefik.http.middlewares.vd-{{.Name}}-mcp-auth.basicauth.users={{.MCPBasicAuth}}"
      # /.well-known/* must NOT sit behind basicauth. MCP clients probe it for
      # OAuth metadata; a 401 there reads as "do the OAuth flow" and the client
      # drops the Basic credentials it already holds. A 404 is the answer it needs.
      #
      # No explicit priority. Traefik derives priority from rule length, and this
      # rule is a strict superset of the one above, so it always wins. A literal
      # priority=100 would have to beat a default that grows with the app name —
      # at 62 characters it silently stops winning and /.well-known/ falls behind
      # the auth middleware.
      - "traefik.http.routers.vd-{{.Name}}-mcp-wellknown.rule=Host(`{{.Name}}.mcp.{{.Domain}}`) && PathPrefix(`/.well-known/`)"
      - "traefik.http.routers.vd-{{.Name}}-mcp-wellknown.entrypoints=web"
      - "traefik.http.routers.vd-{{.Name}}-mcp-wellknown.service=vd-{{.Name}}-mcp"
    networks:
      - vd-net
      - vd-db
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # A crash-looping MCP would otherwise present as a working endpoint that
    # times out. Nothing gates the deploy on this — vd waits only on the app
    # container — but vd status reports it, so a dead MCP is visible.
    healthcheck:
      test: ["CMD", "/app/.venv/bin/python", "-c", "import socket; socket.create_connection(('127.0.0.1', 8089), 3).close()"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
{{- end}}

networks:
  vd-net:
    external: true
{{- if or .NeedsDB .NeedsMCP}}
  vd-db:
    external: true
{{- end}}
